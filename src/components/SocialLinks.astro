---
import { Icon } from 'astro-icon/components'

interface SocialLinksProps {
  linkedin?: string
  twitter?: string
  url?: string
  github?: string
  bluesky?: string
}

interface Props {
  links: SocialLinksProps
}

const links = Astro.props.links

const linkedin = links.linkedin
const twitter = links.twitter
const url = links.url
const github = links.github
const bluesky = links.bluesky
---

<style>
  ul {
    list-style: none;
    margin: 8px 0 0 0;
    padding: 0;
  }
  li {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  svg {
    width: 16px;
    margin-right: 4px;
  }
</style>
<ul>
  {
    linkedin && (
      <li class="links-list">
        <Icon name="fa6-brands:linkedin" size={18} />
        <a target="_blank" href={`https://www.linkedin.com/in/${linkedin}`}>
          {linkedin}
        </a>
      </li>
    )
  }
  {
    twitter && (
      <li class="links-list">
        <Icon name="fa6-brands:twitter" size={18} />
        <a target="_blank" href={`https://twitter.com/${twitter}`}>
          @{twitter}
        </a>
      </li>
    )
  }
  {
    url && (
      <li class="links-list">
        <Icon name="fa6-solid:globe" size={18} />
        <a target="_blank" href={url}>
          {url.split('://')[1]}
        </a>
      </li>
    )
  }
  {
    github && (
      <li class="links-list">
        <Icon name="fa6-brands:github" size={18} />
        <a target="_blank" href={`https://github.com/${github}`}>
          {github}
        </a>
      </li>
    )
  }
  {
    bluesky && (
      <li class="links-list">
        <Icon name="fa6-brands:bluesky" size={18} />
        <a target="_blank" href={`https://bsky.app/profile/${bluesky}`}>
          {bluesky}
        </a>
      </li>
    )
  }
</ul>
